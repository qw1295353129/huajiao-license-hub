# ---------- 运行环境 ----------
NODE_ENV=development
APP_PORT=3000
APP_ORIGIN=http://localhost:5273
TIMEZONE=Asia/Shanghai
SWAGGER_ENABLED=true
LOG_LEVEL=info

# ---------- 数据库 ----------
# postgres：生产使用真实 PostgreSQL；pglite：免安装本地模式（数据落在 PGLITE_DIR）
DATABASE_DRIVER=pglite
DATABASE_URL=postgres://licensehub:licensehub@localhost:5432/licensehub
PGLITE_DIR=./.data/pglite

# ---------- Redis（可选）----------
# 留空则限流/队列使用进程内实现（仅适合单实例）
REDIS_URL=
QUEUE_ENABLED=false

# ---------- 安全密钥（生产必须全部替换！）----------
# openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-please-change-me-0123456789abcdef
# openssl rand -base64 48 —— 授权码盲索引密钥（变更后旧授权码将无法查询）
LICENSE_PEPPER=dev-only-license-pepper-please-change-me-0123456789
# openssl rand -base64 32 —— AES-256-GCM 主密钥
DATA_KEY=ZGV2LW9ubHktZGF0YS1rZXktMzJieXRlcy1sb25nISE=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
TRIAL_DEFAULT_DAYS=14
SELF_UNBIND_PER_30D=3

# ---------- 首次启动引导管理员 ----------
BOOTSTRAP_ADMIN_EMAIL=admin@licensehub.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345

# ---------- 邮件（留空则只写日志，不真发信）----------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LicenseHub <no-reply@example.com>