# ============================================================
# LicenseHub 生产部署环境变量
# 复制为 .env 后修改；所有 CHANGE_ME 必须替换
# ============================================================

# ---------- 对外访问 ----------
WEB_PORT=8080
APP_ORIGIN=http://localhost:8080
TIMEZONE=Asia/Shanghai

# ---------- 数据库 ----------
POSTGRES_USER=licensehub
POSTGRES_DB=licensehub
# ⚠️ 用 -hex 生成 URL 安全的口令：口令会被拼进 postgres:// 连接串，
#    base64 输出里的 “/” 会让连接串无法解析（api 容器会起不来）。
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Redis 访问口令（内网 requirepass）：同样用 -hex，避免 “/”
# openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------- 应用密钥（务必全部替换）----------
# openssl rand -base64 48
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars_long
# 授权码盲索引密钥：变更后旧授权码将无法查询，请勿轻易更换
# openssl rand -base64 48
LICENSE_PEPPER=CHANGE_ME_license_pepper_at_least_32_chars
# AES-256-GCM 主密钥：必须是 base64 编码的 32 字节
# openssl rand -base64 32
DATA_KEY=CHANGE_ME_base64_32_bytes_data_key

# ---------- 首次启动的初始管理员（登录后请立即改密+开双因素）----------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ---------- 邮件（留空则只写日志，不发信）----------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LicenseHub <no-reply@example.com>

# ---------- 其它 ----------
SWAGGER_ENABLED=false
